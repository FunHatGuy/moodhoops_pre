    "section_background_xxMy3p": {
      "type": "section-background",
      "name": "[MH] Background Section",
      "settings": {
        "rich_text": "<p>Thank you for your purchase of the FutureHoop Designer and for including us on your hooping journey!</p><p>We started Moodhoops in 2011 and have been putting our heart and soul into bringing this vibrant flow arts community high quality and fun to use flow props that spark joy and inspiration, whether inside or outside of the circle.</p><p>We are deeply inspired by all of the members of the community that we serve and sincerely appreciate that we get to support you and thrive alongside you.</p><p>Please refer to this guide to start digging into how your FutureHoop Designer operates. We’ve included detailed instructions and helpful videos to get you started, and <a href=\"/pages/contact-us\" title=\"Contact\"><span style=\"text-decoration:underline\">we’re always happy to help answer questions</span></a> if you get stuck.</p>",
        "background_image": "shopify://shop_images/Sponsored-Artist-Morgan-Jenkins-FutureHoop-2024-19-714x1000_1.jpg",
        "enable_eager_loading": false,
        "background_position_x": 50,
        "background_position_y": 0,
        "color_palette": "scheme-2",
        "overlay_opacity": 100,
        "height": "xs",
        "enable_custom_height": false,
        "custom_height": 300,
        "width": "boxed",
