          "settings": {
            "faq_question": "International Power Standards",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>All of our products come with battery chargers that fit standard US electrical outlets. Adapters to fit into non-US wall outlets are not included.</p>",
