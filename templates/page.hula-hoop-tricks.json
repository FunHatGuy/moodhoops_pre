            "section_margin": 50,
            "min_height": 200,
            "left_title": "Advanced Hula Hoop Trick: Foot Hooping Headstand",
            "left_heading_tag": "h3",
            "left_description": "<p>Foot Hooping Head Stand is a trick that allows you to do inverted foot hooping.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/xv7TPyq1RqM",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin in a bent over foot lasso position. </li><li>Place your head on the ground just beyond your hands. </li><li>Hop your non hooping foot forward to straighten out your back. </li><li>Lift your non hooping foot off the ground while raising your hooping foot into the air. </li><li>Make sure not to obstruct the rotation of the hoop by tucking your non hooping foot close to your body.  </li><li>Lower your non hooping foot to the ground to exit the headstand position. Keep your hooping foot raised above your back. Push back up from the ground to return to a foot lasso position.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
