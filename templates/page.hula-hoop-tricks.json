            "left_title": "Advanced Hula Hoop Trick: The Pizza Toss",
            "left_heading_tag": "h3",
            "left_description": "<p>Be sure to learn The Vortex before attempting The Pizza Toss.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
