            "left_title": "Advanced Hula Hoop Trick: Spring Roll",
            "left_heading_tag": "h3",
            "left_description": "<p>Spring Roll is a move that involves doing a forward somersault while hooping.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
