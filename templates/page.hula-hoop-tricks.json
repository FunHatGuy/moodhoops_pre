            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick:Foot Hooping",
            "left_heading_tag": "h3",
            "left_description": "<p>Foot Hooping is a great trick to let yourself take a break and relax on the ground while you continue to amaze your friends!</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
