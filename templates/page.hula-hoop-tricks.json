            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Never Ending Pizza Toss",
            "left_heading_tag": "h3",
            "left_description": "<p>Never Ending Pizza Toss is a continual throwing and catching of the hoop while allowing it to come back onto the body.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/35Luo7_xgMo",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by going into a vortex motion. </li><li>Use the same hand you use for bringing the hoop up into the vortex to toss the hoop.</li><li> Push the toss by bending your knees to jump into the pizza toss.  </li><li>Throw and catch with your non-throwing hand and bring it back down over your body. </li><li> Hand off back around and toss up again continuously.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
