        "video_two_col_hkGGjb": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Advanced Hula Hoop Trick: Jester Dance",
            "left_heading_tag": "h3",
            "left_description": "<p>Jester Dance is a lively move that involves moving the hoop around your body, while jumping in and out of the hoop.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/yyAk7NZM7sk",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Stand up straight and hand the hoop off around your body. </li><li>As the hoop comes around your left side start to spin it in a lasso. Spin the hoop into your legs. </li><li>Quickly lift your left leg and insert it into the hoop. Continue to spin it in a lasso position around your leg. </li><li>As the hoop comes inwards, move your right leg out of the way by extending it high to your side. So the hoop can pass underneath on your left side. </li><li>After it has finished passing underneath, bring your left leg up out of the hoop. </li><li>Pass it off to the other hand. Repeat on the other side.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
