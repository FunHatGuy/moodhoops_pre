        "video_two_col_DV3QQm": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Advanced Hula Hoop Trick: Foot Hooping Forward Spring Roll",
            "left_heading_tag": "h3",
            "left_description": "<p>Spring Roll is a move that involves doing a forward somersault while hooping.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/K1UC1J7mslA",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by foot hooping in Lasso above your back. </li><li>When the hole of the hoop is behind you and the hoop is on the backside of your foot. Use the backside of your foot to pull the hoop in front of you. </li><li>Immediately go into a somersault, do not let your head touch the ground. Keep your foot pointed upwards and spin the hoop around the center of your foot. </li><li>As you roll onto your back, push your hooping foot into the air. Keep your non hooping food close to your body. </li><li>Keep your foot in the air and continue foot hooping.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
