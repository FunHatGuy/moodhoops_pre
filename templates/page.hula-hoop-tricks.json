            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Beginner Hula Hoop Trick: One Handed Basic Isolation",
            "left_heading_tag": "h3",
            "left_description": "<p>One Handed Basic Isolation creates the illusion that the hoop is floating in the air by rotating the hoop in a circular motion around a center point.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/-0nHj2TeFIM",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by holding your hoop in a vertical position in front of you, gripping the hoop over hand at the bottom middle part of the hoop. </li><li>Find the center point of the hoop. </li><li>Rotate the hoop around the center point.</li><li>When your hand arrives at the top of the hoop, rotate your hand in the hoop with the hoop going over the back of your hand. </li><li>Reestablish your grip on the other side of the hoop grabbing the hoop on the inside of the hoop.</li><li>Continue isolating the hoop in a continuous circular motion.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
