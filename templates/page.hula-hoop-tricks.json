        "video_two_col_9xEQCE": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "rgba(0,0,0,0)",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Beginner Hula Hoop Trick: One Leg Escalator",
            "left_heading_tag": "h3",
            "left_description": "<p>The One Leg Escalator involves spinning the hoop clockwise up and around your body.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/wkz0r2Qf-p8",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Take the hoop in your left hand and hold underhand. Place it on your left side. </li><li>Take your left leg, move it forward and place it into the front part of the hoop. </li><li>Take your right hand and place it up against the left side of your forehead to catch the hoop. </li><li>Revolve the hoop clockwise and slightly diagonal towards your body. </li><li>As you bring your hoop in, lift your right leg and step through the hole of the hoop. </li><li>Push and let go of the hoop against the right side of your body, just below your chest. </li><li>Hoop spins up your body over your back and shoulder. </li><li>Use your right hand to catch the hoop to the left just above your head.</li><li> Extend your arm upwards and continue in lasso position.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
