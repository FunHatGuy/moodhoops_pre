            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Advanced Hula Hoop Trick: The Knee to Waist Transfer",
            "left_heading_tag": "h3",
            "left_description": "<p>You must already be able to leg hoop before learning the knee to waste transfer.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/AJ1iF_uGam0",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by entering the hoop and then knee hooping.</li><li>Use one leg to increase the rotation speed of the hoop.</li><li>Raise the heel on one leg off of the ground to push the hoop up to your waist.</li><li>Use a rocking motion to complete the transfer of the hoop to your waste.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
