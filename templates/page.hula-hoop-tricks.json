        "video_two_col_h4cCYt": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "rgba(0,0,0,0)",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Knee Kick Reversals",
            "left_heading_tag": "h3",
            "left_description": "<p>Knee Kick Reversals involve reversing the orbit of your hoop using a knee kick.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/XLMTdssb8nw",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by spinning your hoop around your waist. </li><li>Notice as the hoop spins behind you and presses up against the front right side of your body. At this point, lift your right leg upwards across your body, bending your knee to make contact with the hoop.</li><li>As it makes contact with your knee the hoop will spin in the opposite direction. Maintain this motion.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
