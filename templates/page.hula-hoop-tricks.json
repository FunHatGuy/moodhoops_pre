            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Enter the hoop and spin it at your waste.</li><li>Enter the vortex as you raise your arm.</li><li>As your hand holding the hoop reaches the highest point, toss it into the air with a full arm extension.</li><li>Catch the hoop with your other hand.</li><li>Return the hoop into the vortex and repeat.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
