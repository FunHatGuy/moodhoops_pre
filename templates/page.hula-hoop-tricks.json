            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Advanced Hula Hoop Trick: Spring Roll to Neck Transfer",
            "left_heading_tag": "h3",
            "left_description": "<p>Spring Roll to Neck Transfer is an advanced hooping move that takes the hoop from a behind the back foot lasso position to neck hooping via a somersault.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/wMevZByvkXs",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin in a bent over foot lasso position. </li><li>Do a forward spring roll, do not roll onto your head. </li><li>As you roll onto your back keep your hooping foot raised in the air so there is space to duck into the hoop. </li><li>Tuck your hands into your body to not obstruct the rotation of the hoop. </li><li>Use your forward momentum to tuck into the hoop. </li><li>Sit up straight into a forward roll. </li><li>Continue spinning the hoop around your neck.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
            "right_video_url": "",
            "right_content_alignment": "top-left",
