        "video_two_col_P8LKMJ": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Beginner Hula Hoop Trick: Foot Pass Hand-Off",
            "left_heading_tag": "h3",
            "left_description": "<p>Foot Pass Hand-Off allows you to move the hoop from front to back with your ankle.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/9DO21fdNeeM",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by moving the hoop around your body, handing off in front and behind you. </li><li>When the hoop is in front, kick your foot up and catch it on the hoop. Use the same foot as the direction you are spinning. </li><li>Carry the hoop with your foot alongside your body bringing it around. </li><li>Turn to the opposite side from your elevated foot and grab the hoop.  </li><li>Continue this pattern around your body.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
