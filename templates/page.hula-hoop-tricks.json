        "video_two_col_t4D7hW": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Shoulder Stand Foot Hooping",
            "left_heading_tag": "h3",
            "left_description": "<p>Shoulder Stand Foot Hooping is a vertical move that involves hooping using your feet while in a shoulder stand position.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/PKde7Tnz1yQ",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by hooping on one foot while laying on the ground. </li><li>As the hoop travels across the front side of your foot and the hole of the hoop is in front of you, move the hoop behind your head. </li><li>Go into a shoulder stand by rolling onto your shoulders making sure that your head is straight. Use your hands to help support your back and keep your elbows as close together as possible. </li><li>Extend your hooping foot into the air pointing upwards into a straight line. </li><li>Bend your other leg so your knee comes towards your body. </li><li>Continue foot hooping above your head.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
