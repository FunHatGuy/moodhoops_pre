            "bottom_square_color": "#ffffff"
          }
        },
        "video_two_col_pYPhbK": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 0,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Hula Hooping Around your Chest",
            "left_heading_tag": "h3",
            "left_description": "<p>Hula Hooping Around your Chest involves moving the hoop around your chest with your arms inside the hoop.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/nQw1Dbv-hq0",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by transitioning into chest hooping. There are a number of ways to do this from your waist:<br/>Begin with your hoop at your waist and slide your arms into the hoop and shimmy the hoop up to your chest. Or, begin with your hoop at your waist and increase your hooping momentum to move it to your chest. </li><li>Once the hoop is at your chest, rock your chest back and forth to keep momentum. </li><li>If your arms are inside the hoop, use your arm and shoulders to push the hoop around your body.  </li><li>Keep the hoop in one line as it travels around your body.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
