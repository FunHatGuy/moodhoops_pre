        "video_two_col_QqgHML": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "rgba(0,0,0,0)",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Neck to Foot Pass",
            "left_heading_tag": "h3",
            "left_description": "<p>Neck to Foot Pass is a way to throw the hoop from your neck to your foot.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/yRDLUjZiPFY",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by neck hooping in a standing position. </li><li>As the hoop travels to the right on your neck, quickly duck your head out of the hoop to the left. Face forward as you toss your hoop to aim your toss in front of you . </li><li>Extend and lift your right leg to roughly waist level. Create a hook shape with your foot as you lift. </li><li>Use your foot to catch and hold the hoop. </li><li>Immediately carry the hoop around your body in the direction the hoop has been spinning to maintain momentum. Pass off around your body to your hand.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
            "right_video_url": "",
