        "video_two_col_gk8dRW": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "rgba(0,0,0,0)",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Behind the Back Escalator",
            "left_heading_tag": "h3",
            "left_description": "<p>Behind the Back Escalator allows you to push the hoop in the opposite direction behind you and up your body to be caught above you.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": true,
            "left_custom_text_color": "#000000",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/8nDwdTHd2vs",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by placing the hoop at your side while holding the hoop over hand at the top middle point of the hoop. </li><li>Step your left leg behind you and insert your foot through the back of the hoop. Rest the hoop snug against your leg. </li><li>Place your right hand against the right side of your forehead to catch the hoop. </li><li>Revolve the hoop behind you upwards towards the left side of your back. Simultaneously lift and bend your right leg to your side and step through the entire hoop.</li><li>Firmly push and release the hoop against the side of your back. </li><li>As the hoop moves up your back, catch it in your right hand. </li><li>Rise the hoop above your head and continue in Lasso Position.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
            "right_custom_text_color": "#000000",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
