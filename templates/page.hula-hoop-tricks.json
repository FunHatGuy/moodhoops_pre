        "video_two_col_a3aVU9": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: One Leg Hooping",
            "left_heading_tag": "h3",
            "left_description": "<p>One Leg Hooping is a move that allows you to hoop on one leg just above your knee.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/SQ-gPGFpBvc",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by balancing on the leg you will hoop on. Raise your other leg completely out of the way of the hoops rotation.</li><li>Using your hand, spin the hoop just above your knee. With your foot flat on the ground and knee slightly bent, move your leg back and forth slightly to maintain the orbit of the hoop above your knee. </li><li>Keep the hoop above your knee to maintain motion.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
            "right_video_url": "",
