            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Beginner Hula Hoop Trick: Waist to neck Transfer",
            "left_heading_tag": "h3",
            "left_description": "<p>Waist to neck Transfer allows you to move the hoop from around your waist up your body to your neck with your arms inside the hoop.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/mfnkhIqADRc",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Begin by spinning the hoop around your waist. </li><li>Insert both arms inside the hole as the hoop moves in front of you. Keep your arms at your sides. </li><li>As the hoop spins over each individual arm, lift that shoulders up to  move the hoop up your body to your neck. </li><li>Continue to spin the hoop around your neck.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
