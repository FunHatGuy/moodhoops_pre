        "video_two_col_VRNAc3": {
          "type": "video_two_col",
          "settings": {
            "block_background_type": "color",
            "section_bg_color": "#000000",
            "overlay_opacity": 0,
            "background_image_size": "cover",
            "section_margin": 50,
            "min_height": 200,
            "left_title": "Intermediate Hula Hoop Trick: Helicopter to One Leg Escalator",
            "left_heading_tag": "h3",
            "left_description": "<p>Helicopter to One Leg Escalator allows you to gracefully move the hoop from a helicopter spin up your body.</p>",
            "left_custom_block_padding": "50px 20px 50px 20px",
            "left_enable_custom_text_color": false,
            "left_custom_text_color": "rgba(0,0,0,0)",
            "left_enable_custom_link_color": false,
            "left_custom_link_color": "rgba(0,0,0,0)",
            "left_video_url": "https://youtu.be/04MWxavxATE",
            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Start by doing a helicopter spin around your body clockwise. </li><li>When the hoop comes around the left side of your body, stop it in a vertical position. With your left hand, hold the hoop underhand at the top against your side.  </li><li>With the hoop at your side, insert your left foot through the front side of the hoop. </li><li>Once your foot is in the hoop, so a one leg escalator to move the hoop up your body.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": false,
            "right_custom_text_color": "rgba(0,0,0,0)",
            "right_enable_custom_link_color": false,
            "right_custom_link_color": "rgba(0,0,0,0)",
            "right_video_url": "",
