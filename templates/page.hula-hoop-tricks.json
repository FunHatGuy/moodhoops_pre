            "left_content_alignment": "top-left",
            "left_background_color": "rgba(0,0,0,0)",
            "right_title": "",
            "right_heading_tag": "h3",
            "right_description": "<ol><li>Lay on the ground and begin to rotate the hoop in a lasso on your arm above the center of your body.</li><li>Raise your foot into the air and into the hoop directly next to your hand.</li><li>Pass the hoop to your foot.</li><li>Rotate your foot to continue the momentum.</li></ol>",
            "right_custom_block_padding": "50px 20px 50px 20px",
            "right_enable_custom_text_color": true,
