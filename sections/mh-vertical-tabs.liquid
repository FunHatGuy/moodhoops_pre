{%- assign btn_color = section.settings.buttons_style | split: ' ' | first -%}
{%- assign btn_variant = section.settings.buttons_style | split: ' ' | last -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const verticalTabs = document.querySelectorAll('.mh-vertical-tabs');

    verticalTabs.forEach((tabsContainer) => {
      const tabButtons = tabsContainer.querySelectorAll('.tab-button');
      const tabContents = tabsContainer.querySelectorAll('.tab-content');

      if (tabButtons.length > 0) {
        tabButtons[0].classList.add('active');
      }

      if (tabContents.length > 0) {
        tabContents[0].classList.add('active');
      }

      tabButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          tabButtons.forEach((btn) => btn.classList.remove('active'));
          tabContents.forEach((content) => content.classList.remove('active'));

          button.classList.add('active');
          if (tabContents[index]) {
            tabContents[index].classList.add('active');
          }
        });
      });
    });
  });
</script>

<article class='palette-{{ section.settings.color_palette }} module-color-palette mh-vertical-tabs-container'>
  {% if section.settings.main_section_title != blank %}
    {% assign tag = section.settings.main_section_heading_tag | default: 'h2' %}
    <{{ tag }}
      class='section-title align-{{ section.settings.title_alignment | default: 'center' }}'
      style='--mh-vt-title-color: {{ section.settings.section_title_color | default: 'var(--text)' }};'
    >
      {{ section.settings.main_section_title }}
    </{{ tag }}>
  {% endif %}

  <div class='mh-vertical-tabs' style='--mh-vt-columns-gap: {{ section.settings.columns_gap | default: 30 }}px;'>
    <div
      class='tabs-menu-container'
    >
      <div class='tabs-menu link-btn'>
        {%- for block in section.blocks -%}
          {% if block.type == 'tab' %}
            <button
              class='tab-button overlay-{{ btn_color }}{% if btn_variant == "inv" %} inv{% endif %}'
              id='tab-{{ block.id }}'
              style='
                {% if section.settings.tab_bg_color != blank and section.settings.tab_bg_color != 'transparent' %}
                --secondary_bg_btn: {{ section.settings.tab_bg_color }};
                {% endif %}
                --mh-vt-tab-text-color: {{ section.settings.tab_text_color | default: '#000000' }};
                --mh-vt-tab-active-text-color: {{ section.settings.tab_active_text_color | default: '#ffffff' }};
              '
            >
              {% if block.settings.tab_icon != blank %}
                <span class='tab-icon'>{{ block.settings.tab_icon }}</span>
              {% endif %}
              {{ block.settings.tab_title }}
            </button>
          {% endif %}
        {%- endfor -%}
      </div>
    </div>

    <div class='tabs-content-container'>
      {%- for block in section.blocks -%}
        {% if block.type == 'tab' %}
          <div class='tab-content' id='content-{{ block.id }}'>
            {% if block.settings.content_title != blank %}
              <h3 class='content-title'>{{ block.settings.content_title }}</h3>
            {% endif %}

            {% if block.settings.content_richtext != blank %}
              <div class='content-richtext'>
                {{ block.settings.content_richtext }}
              </div>
            {% endif %}

            {% if block.settings.page != blank %}
              <div class='page-content-wrapper'>
                <div class='page-content-inner'>
                  {% assign page_content = pages[block.settings.page] %}
                  {% if page_content.content != blank %}
                    <div class='rte'>
                      {{ page_content.content }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</article>

{% stylesheet %}
  .mh-vertical-tabs-container {
    width: 100%;
    margin-bottom: var(--spacing);
  }

  .mh-vertical-tabs-container .section-title {
    color: var(--mh-vt-title-color, var(--text));
  }

  .mh-vertical-tabs-container .mh-vertical-tabs {
    display: grid;
    grid-template-columns: minmax(150px, var(--mh-vt-menu-width, 30%)) 1fr;
    gap: var(--mh-vt-columns-gap, 30px);
    width: 100%;
    margin-bottom: var(--mh-vt-section-margin, 50px);
    background-color: var(--mh-vt-section-bg-color, transparent);
    padding: var(--mh-vt-section-padding, 0px);
  }

  .mh-vertical-tabs-container .tabs-menu-container {
    position: relative;
    width: 100%;
  }

  .mh-vertical-tabs-container .tabs-menu {
    display: flex;
    flex-direction: column;
    gap: var(--mh-vt-tabs-gap, 10px);
    position: sticky;
    top: 100px;
  }

  .mh-vertical-tabs-container .tab-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--secondary_bg, #f5f5f5);
    color: var(--mh-vt-tab-text-color, var(--text));
    border: none;
    padding: 12px 20px;
    margin: 0;
    text-align: left;
    word-wrap: break-word;
    white-space: normal;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    border-radius: 4px;
  }

  .mh-vertical-tabs-container .tab-button:hover {
    background-color: var(--primary_bg_btn, #1a73e8);
  }

  .mh-vertical-tabs-container .tab-button.active {
    text-decoration: none;
    font-weight: 600;
    color: var(--mh-vt-tab-active-text-color, #ffffff) !important;
  }

  .mh-vertical-tabs-container .tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mh-vertical-tabs-container .tabs-content-container {
    background-color: var(--mh-vt-content-bg-color, var(--bg_alt));
    border-radius: var(--mh-vt-border-radius, 4px);
    padding: var(--mh-vt-content-padding, 30px);
  }

  .mh-vertical-tabs-container .tab-content {
    display: none;
  }

  .mh-vertical-tabs-container .tab-content.active {
    display: block;
    animation: fadeIn 0.5s;
  }

  .mh-vertical-tabs-container .content-title {
    margin-top: 0;
    margin-bottom: 20px;
    color: var(--heading);
  }

  .mh-vertical-tabs-container .content-richtext {
    margin-bottom: 20px;
    color: var(--text);
  }

  .mh-vertical-tabs-container .page-content-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .mh-vertical-tabs-container .page-content-inner {
    width: 100%;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .mh-vertical-tabs-container .section-title.align-left {
    text-align: left;
  }

  .mh-vertical-tabs-container .section-title.align-center {
    text-align: center;
  }

  .mh-vertical-tabs-container .section-title.align-right {
    text-align: right;
  }

  @media (max-width: 768px) {
    .mh-vertical-tabs-container .mh-vertical-tabs {
      grid-template-columns: 1fr !important;
    }

    .mh-vertical-tabs-container .tabs-menu-container {
      width: 100% !important;
    }

    .mh-vertical-tabs-container .tabs-menu {
      position: relative;
      top: 0;
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: var(--mh-vt-tabs-gap, 10px);
    }

    .mh-vertical-tabs-container .tab-button {
      flex: 1 1 auto;
      min-width: 120px;
      text-align: center;
      justify-content: center;
    }
  }
{% endstylesheet %}

<style>
  #shopify-section-{{ section.id }} {
    --mh-vt-gap: {{ section.settings.gap | default: 20 }}px;
    --mh-vt-section-margin: {{ section.settings.section_margin | default: 50 }}px;
    --mh-vt-section-bg-color: {{ section.settings.section_bg_color | default: "transparent" }};
    --mh-vt-section-padding: {{ section.settings.custom_section_padding | default: "0px" }};
    --mh-vt-menu-width: {{ section.settings.menu_width_percent | default: 30 }}%;
    --mh-vt-tabs-gap: {{ section.settings.tabs_gap | default: 10 }}px;
    --mh-vt-content-bg-color: {{ section.settings.content_bg_color | default: "var(--bg_alt)" }};
    --mh-vt-content-padding: {{ section.settings.content_padding | default: "30px" }};
    --mh-vt-border-radius: {{ section.settings.border_radius | default: 4 }}px;
  }
</style>

