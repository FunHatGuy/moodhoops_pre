      "id": "main_section_title",
      "label": "Section title"
    },
    {
      "type": "select",
      "id": "main_section_heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "Section title tag"
    },
    {
      "type": "select",
      "id": "main_section_title_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Section title alignment"
    },
    {
      "type": "color",
      "id": "section_title_color",
      "label": "Section title color"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "custom_section_padding",
      "label": "Section padding",
      "info": "Example: 20px or 20px 40px"
    },
    {
      "type": "range",
      "id": "section_margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "label": "Section margin bottom (px)"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "label": "Border radius (px)"
    },
    {
      "type": "header",
      "content": "Height Settings"
    },
    {
      "id": "enable_custom_height",
      "type": "checkbox",
      "label": "Enable custom height"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height",
      "min": 250,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "id": "enable_custom_height_mobile",
      "type": "checkbox",
      "label": "Enable custom height for mobile"
    },
    {
      "type": "range",
      "id": "custom_height_mobile",
      "label": "Custom height (mobile)",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "text",
      "id": "columns_template",
      "label": "Desktop columns template",
      "info": "CSS grid-template-columns value. Example: repeat(3, 1fr) or 200px 1fr 200px",
      "default": "repeat(3, 1fr)"
    },
    {
      "type": "text",
      "id": "tablet_columns_template",
      "label": "Tablet columns template",
      "default": "repeat(2, 1fr)"
    },
    {
      "type": "text",
      "id": "mobile_columns_template",
      "label": "Mobile columns template",
      "default": "1fr"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "label": "Grid gap desktop (px)"
    },
    {
      "type": "range",
      "id": "gap_tablet",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 15,
      "label": "Grid gap tablet (px)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 15,
      "label": "Grid gap mobile (px)"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Content Card",
      "settings": [
        {
          "type": "header",
          "content": "Content Selection"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Select page (optional)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection (optional)"
