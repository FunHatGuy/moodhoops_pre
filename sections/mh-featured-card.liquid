        {
          "type": "product",
          "id": "product",
          "label": "Select product (optional)"
        },
        {
          "type": "richtext",
          "id": "rich_text",
          "label": "Rich text content"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background image"
        },
        {
          "type": "checkbox",
          "id": "enable_text_shadow",
          "label": "Enable text shadow",
          "default": false
